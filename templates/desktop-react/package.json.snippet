  "type": "module",
  "scripts": {
    "dev": "node scripts/desktop-dev.mjs",
    "dev:web": "vite",
    "build": "pnpm run desktop:build",
    "build:web": "vite build",
    "preview": "node scripts/desktop-dev.mjs run",
    "preview:web": "vite preview",
    "desktop:dev": "node scripts/desktop-dev.mjs",
