{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./apps/web/src/*"], "@server/*": ["./apps/server/src/*"] }
  },
  "include": [
    "apps",
    "packages",
    "scripts/**/*.d.mts",
    "tests",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
