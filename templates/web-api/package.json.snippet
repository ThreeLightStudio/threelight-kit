{
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm run build:web && pnpm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p apps/server/tsconfig.build.json",
    "start": "node dist/server/app/index.js",
    "preview": "pnpm run start",
    "test": "vitest run",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@app/contracts": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.5"
  }
}
